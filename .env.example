TRIBLER_URL=http://127.0.0.1:52194
TRIBLER_API_KEY=replace-with-the-key-from-tribler
# Optional Windows-only recovery for a stale local Tribler port. On ECONNREFUSED it examines
# only loopback listeners owned by Tribler and accepts exactly one authenticated REST API match.
# It never scans LAN addresses, opens ports, changes router/firewall settings, or rewrites this file.
TRIBLER_AUTO_DISCOVER=false
BRIDGE_PORT=7000
# Optional independent administrative secret: 32 random bytes encoded as 64 hex characters.
# Supply BRIDGE_ADMIN_TOKEN through your local secret manager/process environment.
# If absent, /health, /providers, /downloads and /resolve administration is disabled.
# Never reuse TRIBLER_API_KEY or put the administrative token in a URL or manifest.
# balanced: metadata -> select media -> resume. fast: begin immediately and select as soon as metadata arrives.
TORRENT_SAFETY_MODE=balanced
# Show Internet Archive HTTP/HTTPS variants alongside separately selectable Tribler sources.
ARCHIVE_HTTP_STREAMS=true
# Header/data timeout for a selected Direct HTTP/HTTPS source. Failure does not change transport.
# DIRECT_HTTP_TIMEOUT_MS=8000
# Optional pre-playback check for direct HTTP(S) sources. It uses the same strict
# privacy transport as playback and never exposes URLs in diagnostics or cache keys.
DIRECT_HTTP_PROBE_ENABLED=false
# DIRECT_HTTP_PROBE_TIMEOUT_MS=4000
# DIRECT_HTTP_PROBE_MAX_CANDIDATES=8
# DIRECT_HTTP_PROBE_MAX_CONCURRENT=3
# Optional local JSON scoring policy. Copy config/stream-ranking.default.json to a
# *.local.json file and edit its weights; an invalid configured file stops startup.
# STREAM_RANKING_CONFIG_FILE=./config/stream-ranking.local.json
# Independent stream resolution providers.
STREAM_PROVIDERS=catalog,manual
# Add local_json, external_http and/or stremio_addons here when configuring them below.
# STREAM_PROVIDER_TIMEOUT_MS=5000
# STREAM_PROVIDER_MAX_CONCURRENT=8
# STREAM_PROVIDER_LOCAL_JSON_DIRECTORY=.
# STREAM_PROVIDER_LOCAL_JSON_FILE=./stream-sources.json
STREAM_PROVIDER_EXTERNAL_ENABLED=false
# Public HTTPS or an exact local adapter endpoint such as http://127.0.0.1:7100/resolve.
# Only this exact configured loopback URL is trusted; local URLs returned in streams remain blocked.
# STREAM_PROVIDER_EXTERNAL_URL=https://provider.example/resolve
# Must be greater than PYTHON_ADAPTER_REQUEST_TIMEOUT_SECONDS when using the Python host.
# STREAM_PROVIDER_EXTERNAL_TIMEOUT_MS=10000
# The Python host reads these from its own process environment, not from HTTP.
# Its Kodi resolver stays registered but disabled unless explicitly enabled.
# PYTHON_ADAPTER_KODI_RESOLVER_ENABLED=false
# PYTHON_ADAPTER_KODI_ADDON_PATH=C:\absolute\path\to\local-kodi-addon
# PYTHON_ADAPTER_KODI_ADDON_ID=script.module.local
# PYTHON_ADAPTER_KODI_MODULE=adapter_host.kodi.adapters.p2p_metadata
# PYTHON_ADAPTER_KODI_CALLABLE=resolve
# PYTHON_ADAPTER_KODI_SETTINGS_FILE=C:\absolute\path\to\private-settings.json
# PYTHON_ADAPTER_KODI_PROFILE_PATH=C:\absolute\path\to\kodi-data
# PYTHON_ADAPTER_KODI_WORKER_TIMEOUT_SECONDS=5
# The built-in P2P metadata adapter receives these values only at worker startup.
# They are never accepted from HTTP requests.
# PYTHON_ADAPTER_KODI_SOURCE_MODULE=local_p2p_module.sources.metadata_source
# PYTHON_ADAPTER_KODI_SOURCE_ID=example_p2p
# PYTHON_ADAPTER_KODI_SOURCE_ENABLED_SETTING=provider.example_p2p
# PYTHON_ADAPTER_KODI_SOURCE_RESPONSE_MODE=capture-streams
# Generic standard Stremio addons. Keep credentials and tokens out of manifest URLs.
# STREAM_PROVIDER_STREMIO_ADDONS_FILE=./config/stremio-addons.local.json
# STREMIO_ADDON_MANIFEST_TTL_MS=900000
# STREMIO_ADDON_REQUEST_TIMEOUT_MS=5000
# Optional trusted request metadata; must be an HTTP(S) base directory ending in /.
# The bridge requests meta/movie/<IMDb ID>.json only for movie IDs it needs to enrich.
# STREMIO_MOVIE_METADATA_BASE_URL=https://your-trusted-meta-addon.example/
# Public starter catalog: Sintel, an open movie by the Blender Foundation (CC BY 3.0).
# The configured catalog keeps the demo limited to this explicitly licensed fixture.
CATALOG_PROVIDER=configured
LEGAL_TEST_MAGNET=magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel&tr=udp%3A%2F%2Ftracker.opentrackr.org%3A1337&xs=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2Fsintel.torrent
# Opt in to Internet Archive discovery by setting CATALOG_PROVIDER=internet-archive.
# Its broader query is configurable; check the rights of individual items before use.
# Optional multi-provider list. This file contains no secret values; authenticated
# providers reference separate environment variable names through headersFromEnv.
# CATALOG_SOURCES_FILE=./config/catalog-sources.local.json
# CATALOG_QUERY=mediatype:movies AND format:"Archive BitTorrent" AND (collection:feature_films OR collection:animationandcartoons)
# CATALOG_PAGE_SIZE=50
# CATALOG_CACHE_TTL_MS=300000
# CATALOG_REQUEST_TIMEOUT_MS=15000

# HTTP/HTTPS playback privacy (strict and system DNS are the only implemented modes).
# HTTP_PRIVACY_MODE=strict
# HTTP_PRIVACY_SEND_REFERER=false
# HTTP_PRIVACY_ACCEPT_COOKIES=false
# HTTP_PRIVACY_USER_AGENT=minimal
# HTTP_PRIVACY_CUSTOM_USER_AGENT=
# Optional trusted startup JSON; exact source/recipient origins and only necessary header values.
# Keep actual exceptions in the ignored local environment, never in provider responses.
# HTTP_SOURCE_HEADER_RULES=[]
# /source playback tokens expire after this many seconds without a valid request.
# HTTP_STREAM_TOKEN_TTL_SECONDS=3600
# HTTP_STREAM_TOKEN_MAX_ENTRIES=1000
# DNS_MODE=system
# DNS_DOH_ENDPOINT=

# METADATA_TIMEOUT_MS=90000
# NO_SEEDS_TIMEOUT_MS=30000
# STREAM_HEADER_TIMEOUT_MS=30000
# Bounded, per-request read-ahead after bytes have already arrived from local Tribler.
TRIBLER_STREAM_BUFFER_ENABLED=true
TRIBLER_STREAM_STARTUP_BUFFER_MIB=8
TRIBLER_STREAM_SEEK_BUFFER_MIB=4
TRIBLER_STREAM_MAX_BUFFER_MIB=64
TRIBLER_STREAM_PREBUFFER_TIMEOUT_MS=15000
# Lifecycle policy for bridge-created downloads: smart, ephemeral, or keep_all.
# smart promotes meaningful playback from 30-minute to 7-day idle retention;
# ephemeral always uses 30 minutes; keep_all disables automatic removal.
DOWNLOAD_RETENTION_MODE=smart
# CLEANUP_INTERVAL_MS=60000
# CLEANUP_REMOVE_DATA=true
